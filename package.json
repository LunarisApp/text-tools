{
  "name": "text-tools",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@typescript/typescript6": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "rollup": "^4.53.2",
    "rollup-plugin-dts": "^6.5.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "ultracite": "^7.8.3"
  },
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  }
}
